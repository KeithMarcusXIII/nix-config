#!/usr/bin/env bash

# Workaround: secretspec's BWS provider hardcodes --server-url https://bitwarden.com
# (the web vault). This wrapper strips it so BWS CLI uses its correct defaults.
export SECRETSPEC_BWS_CLI_PATH="${PWD}/scripts/bws-secretspec.sh"

eval "$(devenv direnvrc)"

# You can pass flags to the devenv command
# For example: use devenv --impure --option services.postgres.enable:bool true
use devenv